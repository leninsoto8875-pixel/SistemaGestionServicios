@model List<Dominio.Entidades.Reparacion>

@{
    ViewData["Title"] = "Reparaciones";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between mb-3">
        <h2>Reparaciones</h2>
        <a asp-action="Crear" class="btn btn-primary">Nueva reparación</a>
    </div>

    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-success">@TempData["Mensaje"]</div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <table class="table table-bordered table-striped">
        <thead>
            <tr>
                <th>ID</th>
                <th>Equipo</th>
                <th>Fecha ingreso</th>
                <th>Problema</th>
                <th>Diagnóstico</th>
                <th>Estado</th>
                <th>Cambiar estado</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var reparacion in Model)
            {
                <tr>
                    <td>@reparacion.IdReparacion</td>
                    <td>@reparacion.IdEquipo</td>
                    <td>@reparacion.FechaIngreso.ToString("dd/MM/yyyy")</td>
                    <td>@reparacion.ProblemaReportado</td>
                    <td>@reparacion.Diagnostico</td>
                    <td><strong>@reparacion.Estado</strong></td>

                    <td>
                        <form asp-action="CambiarEstado" method="post">
                            <input type="hidden"
                                   name="id"
                                   value="@reparacion.IdReparacion" />

                            <select name="estado"
                                    class="form-select form-select-sm mb-2">
                                <option value="Recibido">Recibido</option>
                                <option value="En diagnostico">En diagnóstico</option>
                                <option value="En reparacion">En reparación</option>
                                <option value="Listo">Listo</option>
                                <option value="Entregado">Entregado</option>
                            </select>

                            <button class="btn btn-sm btn-success">
                                Actualizar
                            </button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>