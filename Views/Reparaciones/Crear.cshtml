@{
    ViewData["Title"] = "Nueva reparación";
}

<div class="container mt-4">

    <h2>Registrar reparación</h2>

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger">@ViewBag.Error</div>
    }

    <form asp-action="Crear" method="post">

        <div class="mb-3">
            <label class="form-label">Equipo</label>

            <select name="idEquipo" class="form-select">
                <option value="">Seleccione un equipo</option>

                @foreach (var equipo in ViewBag.Equipos)
                {
                    <option value="@equipo.IdEquipo">
                        @equipo.IdEquipo - @equipo.Tipo - @equipo.Marca @equipo.Modelo
                    </option>
                }
            </select>
        </div>

        <div class="mb-3">
            <label class="form-label">Problema reportado</label>

            <textarea name="problema"
                      class="form-control"
                      rows="4"></textarea>
        </div>

        <button type="submit" class="btn btn-success">
            Registrar reparación
        </button>

        <a asp-action="Index" class="btn btn-secondary">
            Cancelar
        </a>

    </form>
</div>